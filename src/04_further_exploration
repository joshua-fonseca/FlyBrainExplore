import pandas as pd
from pathlib import Path

root = Path(__file__).resolve().parent.parent
neurons_file = root / 'data' / 'body-annotations-male-cns-v1.0-minconf-0.5.feather'
df = pd.read_feather(neurons_file)

traced = df[df['status'] == 'Traced']

# more for building
id_to_superclass = traced.set_index('bodyId')['superclass'].to_dict()

connections_file = root / 'data' / 'connectome-weights-male-cns-v1.0-minconf-0.5.feather'

import pyarrow.dataset as ds
import pyarrow.compute as pc

dataset = ds.dataset(connections_file, format="feather")

# question: does audio input exists at all in this data?

# in the annotations cheatsheet, this superclass relates to sensory input not through vnc (possibly hearing)
cb_sensory = traced[traced['superclass'] == 'cb_sensory']

# receptorType: what sensory neurons
# entryNerve: which nerve carries the neuron
print(cb_sensory['receptorType'].value_counts()) 
print(cb_sensory['entryNerve'].value_counts())
# result:
# receptorType came back empty, entryNerve did come back

print('debug')
print(traced[['superclass', 'receptorType']].value_counts())
# result:
# receptorType isn't broken, it's just populated for vnc_sensory, not cb_sensory

# receptorTypes are ppk23 ppk25 IR52b, part of vnc_sensory
# but apparently ppk23, ppk25, and IR52b are genes that play roles in
# pheromone detection, species recognition, and the regulation of courtship behaviors
# conclusion: receptor types may not be useful to look at

# however, for the entryNerve, AN has a large neuron count (AN is assumed to be the antenna of the fly)
# AN neurons are hearing, smell, or a mix of both, since the antenna carries both

# Check if type or class gives a modality clue for the AN group, since receptorType won't
an_neurons = traced[traced['entryNerve'] == 'AN']
print(an_neurons['class'].value_counts())
# class confirmed mechanosensory neurons exist
# # 744 in class mechanosensory -> systems that can respond to sound, touch, motion, etc

print(an_neurons['type'].value_counts().head(20))
# finer-grained follow-up
# a few JO-xxxxx types -> johnston's organ on antenna (responsible for Hearing and Sound Detection)

# drill down on the JO types
jo_neurons = traced[traced['type'].str.contains('JO', na=False)]
print(jo_neurons['type'].value_counts())
print(jo_neurons.shape)

# it looks like there is a lot of JO families maybe for a different purpose -> research

# JO is split into 5 subgroups by projection pattern in the brain: JO-A through JO-E
# only JO-A and JO-B are actually sound/vibration sensors
# - JO-A: high frequency tuned, connects strongly to the escape pathway
# - JO-B: low frequency tuned, connects to both escape AND the song-relay pathway
#   (song-relay is fly courtship song processing, closest match to "rhythm")
# JO-C, JO-D, JO-E are NOT sound, they sense wind/gravity instead

# source: Ishikawa et al. 2020 (frontiersin.org/articles/10.3389/fphys.2019.01552)
#         Mamiya lab et al., wiring patterns paper (pmc.ncbi.nlm.nih.gov/articles/PMC7676477)

jo_auditory = jo_neurons[jo_neurons['type'].str.contains('JO-A|JO-B', na=False, regex=True)]
print(jo_auditory['type'].value_counts())
print(jo_auditory.shape)

# JO-B outnumbers JO-A, 82 versus 50, once you sum each family's subtypes.
# Combined with the finding that JO-B is the one wired toward song-relay, and more neurons,
# JO-B is a strong candidate for a rhythm-based input stage

# side track:
# remember in the initial exploration, it was concluded an image had to go from ol_sensory -> vnc_motor
# there was a gap in that which was was revealed in this exercise: the subgroups of ol_sensory and vnc_motor
# were not checked. it is not known if the correct responsible neurons were used, so that will be checked.

ol_sensory_neurons = traced[traced['superclass'] == 'ol_sensory']
print(ol_sensory_neurons['type'].value_counts())
print(ol_sensory_neurons.shape)
# by sheer luck, the random neuron chosen for the ol_sensory was of type R1-R6, which is responsible for
# motion and brightness detection which is more appropriate to reacting to a moving visual pattern

# now to check the other end, vnc_motor
vnc_motor_neurons = traced[traced['superclass'] == 'vnc_motor']
print(vnc_motor_neurons['type'].value_counts())
print(vnc_motor_neurons.shape)

print(vnc_motor_neurons['exitNerve'].value_counts())

print(vnc_motor_neurons['somaNeuromere'].value_counts())

# check the end node of the path traced in 03_scaled_lif.py
print(vnc_motor_neurons[vnc_motor_neurons['bodyId'] == 164190][['type', 'exitNerve', 'somaNeuromere']])
# result: it is cooked
#           type exitNerve somaNeuromere
# 116318  MNad21      AbN2            A1

# Ab almost certainly stands for abdominal, in A1, the first abdominal segment
# So next time, check both start and end points for where they actually are
# This would help find a leg motor:

# leg_motor_ids = vnc_motor_neurons[vnc_motor_neurons['somaNeuromere'].isin(['T1', 'T2', 'T3'])]['bodyId']
# valid_targets = [nid for nid in leg_motor_ids if nid in G.nodes]
# print(len(valid_targets))

# reachable = nx.descendants(G, source_id)
# reachable_motor = [nid for nid in valid_targets if nid in reachable]
# print(len(reachable_motor))

# returning back to the JO neurons,
# the next step would be to try and make a path just like ol_sensory -> vnc_motor

# -------------------------------

# except this time, do it by hand.
# networkx can absolutely find a shortest path between two IDs in one line
# but it's not known which two IDs matter, there is no confirmed "sound goes in here" neuron
# and a confirmed "movement comes out here" neuron to connect. thus hopping manually is done.

# prints all columns - to look for any JO-B* neurons
# with pd.option_context('display.max_columns', None):
#     print(jo_auditory.head())

jo_id = jo_auditory['bodyId'].iloc[3] # with the above, it was found to be here
print('bodyId we are interested in:', jo_id)

# building starts -> what neurons are outbound from the chosen JO-B* one

# same neighbour-finding move that was now done twice
filter_expr = (pc.field("body_pre") == jo_id) | (pc.field("body_post") == jo_id)
jo_neighbours = dataset.to_table(filter=filter_expr).to_pandas()
print(jo_neighbours.shape)
print(jo_neighbours)

#       body_pre  body_post  weight
# 0        42619      15233      46
# 1        42619     525475      45
# 2        42619      13014      42
# 3        42619      11378      42
# 4        42619      12066      39
# ..         ...        ...     ...
# 280  915820880      42619       1
# 281      10074      42619       1
# 282  923995712      42619       1
# 283  941637235      42619       1
# 284  968187269      42619       1

# Note: Some body_pre/body_post values are enormous

# Same move as with 11139 and ol_sensory,
# translate through id_to_superclass before trusting any of these IDs as meaningful:
jo_neighbours['pre_type'] = jo_neighbours['body_pre'].map(id_to_superclass)
jo_neighbours['post_type'] = jo_neighbours['body_post'].map(id_to_superclass)

print(jo_neighbours['pre_type'].value_counts(dropna=False))
print(jo_neighbours['post_type'].value_counts(dropna=False))
# dropna=False matters here specifically, want to actually see how many of those 285 rows map to NaN
# mainly want to see if NaN contributes a lot or not

# since the strongest connections are the ones most likely to matter for a "does this respond to rhythmic input" story,
# sort and look at the top few by weight directly:
top_outgoing = jo_neighbours[jo_neighbours['body_pre'] == jo_id].sort_values('weight', ascending=False)
print(top_outgoing.head(10))
# results:
# - JO-B1_a itself classifies as cb_sensory -> they're already central-brain sensory (AN carries straight to brain)
# - strongest connections are ALL from the sensory neuron to CB processing neurons, and it's all quite consistent
# unlike in the ol_sensory, it went to different superclasses of neurons within it's top 10 weights

# in post_type, there are 177 NaN rows. alot! so see if those rows contribute a lot of weight:
weighted_targets = (
    jo_neighbours[jo_neighbours['body_pre'] == jo_id]
    .groupby('post_type', dropna=False)['weight']
    .sum()
    .sort_values(ascending=False)
)
print(weighted_targets)
# so 177 NaN values sum to 302 weight, compared to cb_intrinsic which sums to 490

# see how heavy the weights are of the NaN values
nan_targets = jo_neighbours[
    (jo_neighbours['body_pre'] == jo_id) & (jo_neighbours['post_type'].isna())
]
print(nan_targets.sort_values('weight', ascending=False))
# result: The weights are all tiny (9 down to 1)
# this means a lot of weak connections

# for further testing:
nan_ids = nan_targets['body_post'].unique()
print(df[df['bodyId'].isin(nan_ids)][['bodyId', 'status', 'statusLabel']])
# only returned 2 -> says that many of the connections supposedly exist but are not annotated

# further confirming it
# print(len(nan_ids), 'unique nan targets')
# print(df['bodyId'].isin(nan_ids).sum(), 'of those exist anywhere in df')

# 527138 is from above, it's weird because its traced but still empty
print(traced[traced['bodyId'] == 527138][['bodyId', 'status', 'statusLabel', 'superclass', 'class', 'type']])
# otherwise: JO-B1_a's wiring has a strong, concentrated signal into cb_intrinsic,
# with a long tail of weak connections mostly landing on unannotated fragments,
# and one lone Traced-but-unclassified neuron sitting in that tail

# Then the natural next hop: pick the single strongest target, body_post 15233, weight 46

next_id = 15233
filter_expr = (pc.field("body_pre") == next_id) | (pc.field("body_post") == next_id)
next_neighbours = dataset.to_table(filter=filter_expr).to_pandas()
next_neighbours['pre_type'] = next_neighbours['body_pre'].map(id_to_superclass)
next_neighbours['post_type'] = next_neighbours['body_post'].map(id_to_superclass)
print(next_neighbours.shape) # (1423, 5) -> a lot more neighbours
print(next_neighbours['post_type'].value_counts(dropna=False))
# results:
# from the output there is 5 descending neurons, which may be the bridge from brain to vnc
# next, filter to outgoing only before asking "where does its signal go"

outgoing = next_neighbours[next_neighbours['body_pre'] == next_id]
print(outgoing.shape)
print(outgoing['post_type'].value_counts(dropna=False))

weighted_out = (
    outgoing.groupby('post_type', dropna=False)['weight']
    .sum()
    .sort_values(ascending=False)
)
print(weighted_out)
# results:
# cb_intrinsic is still the biggest bucket by weight, 1148
# that says, central-brain intrinsic neurons are talking mostly to other central-brain intrinsic neurons.
# descending_neuron is real but small, 42 out of 2507 total weight

# the bridge toward VNC/motor, and right now it's a trickle, not a highway
# Worth knowing precisely before deciding whether this is a dead end or just a narrow doorway:
descending_out = outgoing[outgoing['post_type'] == 'descending_neuron'].sort_values('weight', ascending=False)
print(descending_out)
# so, these five digit IDs are clustered in the same narrow range as 10001, which was DNp01 (the Giant Fiber)

# just checking the body_post to see what they are
descending_ids = descending_out['body_post'].tolist()
print(traced[traced['bodyId'].isin(descending_ids)][['bodyId', 'type', 'hemibrainType', 'synonyms']])
# turns out Two out of five come back with real names attached:
# DNp02, tagged Matsuo 2016: P3b, is the brain's first relay station for auditory input
# DNg24, tagged Matsuo 2016: AMMC-Db7, same auditory-adjacent naming family. Weaker connection, but also real
# DNge031, DNg29, WED180, has no information or publication yet

# knowing about DNp02, that will be used
#      bodyId     type hemibrainType               synonyms
# 181   10197    DNp02         DNp02       Matsuo 2016: P3b
dnp02_id = 10197

filter_expr = (pc.field("body_pre") == dnp02_id) | (pc.field("body_post") == dnp02_id)
dnp02_neighbours = dataset.to_table(filter=filter_expr).to_pandas()

dnp02_neighbours['pre_type'] = dnp02_neighbours['body_pre'].map(id_to_superclass)
dnp02_neighbours['post_type'] = dnp02_neighbours['body_post'].map(id_to_superclass)

outgoing = dnp02_neighbours[dnp02_neighbours['body_pre'] == dnp02_id]
print(outgoing.shape)

weighted_out = (
    outgoing.groupby('post_type', dropna=False)['weight']
    .sum()
    .sort_values(ascending=False)
)
print(weighted_out)
# result
# there exists a connection to vnc_motor! weight 50.

# however, Total outgoing weight here is roughly 14,679, and vnc_motor is 50 of that
# Compare that to vnc_intrinsic at 2510...
# The tiny direct vnc_motor link found might be a real but minor shortcut,
# while the "real" rhythm-generating pathway is likely one more hop through vnc_intrinsic

# NaN bucket is now 9482, DNp02 is clearly a major hub (6945 outgoing edges vs JO-B1_a's 285)
# so a bigger unannotated tail isn't shocking, but "not shocking" isn't the same as "checked."

nan_out = outgoing[outgoing['post_type'].isna()]
nan_ids = nan_out['body_post'].unique()
print(len(nan_ids), 'unique nan targets') # 6369
print(df[df['bodyId'].isin(nan_ids)]['status'].value_counts()) # 2 of each: orphan, glia, unimportant
# only 6 of 6369 unique targets exist in df at all
# NaN weight really is just "signal going into the unfinished part of the segmentation"

# And identify the actual vnc_motor neurons that were hit directly
motor_targets = outgoing[outgoing['post_type'] == 'vnc_motor'].sort_values('weight', ascending=False)
print(traced[traced['bodyId'].isin(motor_targets['body_post'])][['bodyId', 'type', 'instance', 'somaNeuromere']])
# so named leg muscle motor neurons were hit:
# one that should jump out immediately: TTMn
# That's the tergotrochanteral motor neuron, the same effector neuron driven by DNp01, the Giant Fiber,
# to trigger a fly's jump-takeoff escape response, the very first neuron looked at

# an auditory-descending pathway (DNp02) also drives that same jump muscle,
# alongside genuine leg-extensor and leg-flexor motor neuron
# And every single one of these sits at somaNeuromere == T2, the mesothoracic segment,
# which controls the middle pair of legs, the fly's primary walking/jumping legs.

